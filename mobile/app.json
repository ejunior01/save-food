{
  "expo": {
    "name": "DespensaCerta",
    "slug": "despensa-certa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#e8dfcb",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#e8dfcb"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Necessário para escanear códigos de barras e tirar fotos dos alimentos.",
        "NSPhotoLibraryUsageDescription": "Necessário para adicionar fotos dos seus alimentos.",
        "NSMicrophoneUsageDescription": "Necessário para gravar áudios relacionados aos alimentos."
      },
      "backgroundColor": "#e8dfcb"
    },
    "android": {
      "package": "br.com.despensacerta",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#e8dfcb"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "userInterfaceStyle": "light"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-system-ui",
      [
        "expo-camera",
        {
          "cameraPermission": "Necessário para escanear códigos de barras e tirar fotos dos alimentos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Necessário para adicionar fotos dos seus alimentos.",
          "cameraPermission": "Necessário para tirar fotos dos alimentos."
        }
      ],
      "expo-audio",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#e8dfcb",
          "image": "./assets/splash-icon.png",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#e8dfcb"
          },
          "imageWidth": 200,
          "resizeMode": "native"
        }
      ]
    ]
  }
}
